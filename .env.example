# Copy this file to .env and fill in your local values.
# .env is already git-ignored — never commit real secrets.

# --- PostgreSQL -------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Example for a local Postgres install with a database called "playsphere":
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/playsphere?schema=public"

# --- Auth ---------------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
JWT_SECRET="replace-this-with-a-long-random-string"

# Required to create an Admin account through the Register page (pick
# "Admin" as the role, then enter this code). Leave unset to disable
# admin sign-up entirely. Pick your own value — this is just an example.
ADMIN_SIGNUP_CODE="playsphere-admin-2026"

# --- App ------------------------------------------------------------
PORT=3000
NODE_ENV=development
